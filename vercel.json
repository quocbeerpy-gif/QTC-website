{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*hrcgroup.*"
        }
      ],
      "destination": "/vuanghe",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/tuyensinh", "destination": "/tuyensinh.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/vuanghe", "destination": "/vuanghe.html" },
    { "source": "/duan", "destination": "/duan/index.html" },
    { "source": "/hrchealth", "destination": "/hrchealth/index.html" },
    { "source": "/qtcaimathgame", "destination": "/qtcaimathgame.html" }
     ]
}
